{
  "name": "story-team-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Бот-контентщик для канала STORY | TEAM: сбор исторических фото из открытых архивов, подготовка постов, аппрув редакторами, публикация по расписанию",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "dotenv": "^16.4.7",
    "postgres": "^3.4.5",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
